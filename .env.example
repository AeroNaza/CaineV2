# Copia este archivo como .env solo si usas una herramienta para cargarlo.
# La aplicación actual lee la variable desde el entorno del proceso.
GEMINI_API_KEY=pon_aqui_tu_clave_nueva

# Opcional: cambia la voz de Edge TTS.
CAINE_TTS_VOICE=es-CO-LuisNeural

# Opcional: puerto serial de la micro:bit.
CAINE_SERIAL_PORT=/dev/ttyACM0
